<?xml version="1.0"?>
<package format="3">
    <name>xsens_mvn_ros2</name>
    <version>0.0.1</version>
    <description>ROS2 package for processing XSens MVN data, integrating with XSens Awinda suit</description>
    <maintainer email="mattia.leonori@iit.it">Mattia Leonori</maintainer>
    <maintainer email="marta.lorenzini@iit.it">Marta Lorenzini</maintainer>
    <license>BSD</license>
    <url type="repository">https://github.com/hrii-iit/xsens_mvn_ros</url>
    <author email="mattia.leonori@iit.it">Mattia Leonori</author>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>rclpy</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>urdf</depend>
    <depend>tf2_eigen</depend>
    <depend>rcpputils</depend>
    <depend>xsens_mvn_ros2_msgs</depend>
    <depend>rviz2</depend>
    <depend>eigen</depend>
    <depend>boost</depend>
    <depend>launch</depend>
    <depend>launch_ros</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>