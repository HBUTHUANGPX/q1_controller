<?xml version="1.0"?>
<package format="3">
    <name>xsens_mvn_ros2_msgs</name>
    <version>0.0.1</version>
    <description>xsens_mvn_ros2_msgs provides messages for XSens Awinda suit such as link states.</description>
    <maintainer email="mattia.leonori@iit.it">Mattia Leonori</maintainer>
    <maintainer email="marta.lorenzini@iit.it">Marta Lorenzini</maintainer>
    <license>BSD</license>
    <url type="repository">https://github.com/hrii-iit/xsens_mvn_ros2_msgs</url>
    <author email="mattia.leonori@iit.it">Mattia Leonori</author>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>builtin_interfaces</depend>

    <exec_depend>rosidl_default_runtime</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>