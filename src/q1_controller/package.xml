<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>q1_controller</name>
  <version>0.0.0</version>
  <description>Simple PD controller for robot joints</description>
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>  <!-- 新增：生成消息接口 -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>  <!-- 支持Python -->

  <depend>rclcpp</depend>  <!-- C++核心 -->
  <depend>rclpy</depend>   <!-- Python核心 -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cuda</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <depend>zlib</depend>
  <depend>dexterous_hand</depend>
  <!-- <depend>pinocchio</depend>   -->
  <!-- <depend>communication</depend> -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>